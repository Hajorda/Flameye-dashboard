# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=wildfire
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://wildfire:changeme@postgres:5432/wildfire

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Camera Agent ──────────────────────────────────────────────────────────────
# Accepts RTSP URLs (rtsp://...) or YouTube URLs for testing
STREAM_URL=https://www.youtube.com/watch?v=PASTE_YOUTUBE_URL_HERE
CAMERA_ID=1
FRAME_INTERVAL=2.0          # seconds between frames
JPEG_QUALITY=85             # 1–100
STREAM_MAX_LEN=50           # max unread frames kept in Redis
YOUTUBE_REFRESH_FRAMES=1800 # re-resolve YouTube URL every N frames (~1h at 2s)

# ── Inference Worker ──────────────────────────────────────────────────────────
MODEL_PATH=/models/fire_model.pt   # or fire_model.onnx for ONNX runtime
CONFIDENCE_THRESHOLD=0.5
STREAM_KEY=frames:1                # must match CAMERA_ID above
CONSUMER_ID=worker_1
ALERT_COOLDOWN_SECONDS=600        # suppress repeat alerts for 10 min
ALERT_CLASSES=fire,smoke,other    # which detected classes trigger an alert (comma-separated)

# ── Notifications (optional — leave blank to disable) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000


OPENWEATHERMAP_API_KEY=
NASA_FIRMS_MAP_KEY=